LLM_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-2.0-flash
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=
EMBEDDING_BATCH_SIZE=128
EMBEDDING_REVISION=default
EMBEDDING_DEVICE=cpu
CHROMA_PATH=data/vectorstore
CHROMA_COLLECTION=genai_documents
ALLOWED_FILE_ROOT=data/samples
MAX_FILE_BYTES=5000000
MAX_DOCUMENT_PAGES=100
MAX_IMAGE_PIXELS=40000000
OCR_ENABLED=false
OCR_LANGUAGE=eng
OCR_FALLBACK_THRESHOLD=20
OCR_DPI=200
# Optional absolute path when tesseract.exe is not on PATH
TESSERACT_CMD=
CHAT_PERSISTENCE_ENABLED=false
CHAT_DATABASE_PATH=data/conversations.sqlite3
# For restart-stable isolation, configure a trusted auth-proxy header and secret.
CHAT_OWNER_HEADER=
CHAT_SESSION_SECRET=
TEMPERATURE=0
REQUEST_TIMEOUT=45
MAX_RETRIES=2
